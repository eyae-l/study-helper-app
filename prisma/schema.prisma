// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  studySets     StudySet[]
  flashcards    Flashcard[]
  quizzes       Quiz[]
  sessions      Session[]
  progress      Progress[]
}

// Session model for authentication
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Study Set model
model StudySet {
  id          String   @id @default(cuid())
  title       String
  description String?
  subject     String
  userId      String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards  Flashcard[]
  quizzes     Quiz[]

  @@index([userId])
  @@index([subject])
}

// Flashcard model
model Flashcard {
  id          String   @id @default(cuid())
  front       String
  back        String
  studySetId  String
  userId      String
  difficulty  Int      @default(1) // 1-5 scale
  nextReview  DateTime?
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  studySet    StudySet   @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    Progress[]

  @@index([userId])
  @@index([studySetId])
  @@index([nextReview])
}

// Quiz model
model Quiz {
  id          String   @id @default(cuid())
  title       String
  studySetId  String
  userId      String
  questions   Json     // Array of questions with options and answers
  totalScore  Int      @default(0)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  studySet    StudySet @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([studySetId])
}

// Progress tracking model
model Progress {
  id           String    @id @default(cuid())
  userId       String
  flashcardId  String
  masteryLevel Int       @default(0) // 0-100 scale
  lastReviewed DateTime?
  timesReviewed Int      @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId])
  @@index([flashcardId])
}

// Upload model for tracking uploaded files
model Upload {
  id          String   @id @default(cuid())
  fileName    String
  fileType    String
  fileUrl     String
  fileSize    Int
  userId      String
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
